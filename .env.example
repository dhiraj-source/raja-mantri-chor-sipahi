# Copy this file to .env for local development.
POSTGRES_USER=rmc
POSTGRES_PASSWORD=rmc_dev_password
POSTGRES_DB=rmc
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
# API isse PostgreSQL se judti hai (migrations start par apne aap chalti hain).
# Hata do to accounts sirf memory me rahenge.
DATABASE_URL=postgres://rmc:rmc_dev_password@localhost:5432/rmc
