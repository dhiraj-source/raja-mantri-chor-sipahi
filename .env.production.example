# Ye API (Railway) par set karne wale environment variables hain (production).
# .env (local dev) se alag hai — ye file sirf reference ke liye hai, code isse padhta nahi.

# Railway PostgreSQL plugin add karne ke baad, is variable ko us plugin se reference karo
# (Railway dashboard me: "${{Postgres.DATABASE_URL}}"), khud se mat likho.
DATABASE_URL=postgres://user:password@host:5432/railway

# Railway Redis plugin add karne ke baad wahi tarah reference karo: "${{Redis.REDIS_URL}}".
# NOTE: Redis abhi provision hota hai par app code use nahi karta (rooms/sessions ab bhi
# memory me hain). Ye agli feature ke liye ready rakha hai.
REDIS_URL=redis://user:password@host:6379

# Vercel par web deploy hone ke BAAD, uska asli URL yahan daalo (comma se kai origins).
CORS_ORIGINS=https://your-app.vercel.app

# In sabki zaroorat kam hi padhti hai, defaults theek hain:
# PORT           - Railway khud set karta hai, chhedo mat
# RECONNECT_GRACE_MS      - default 60000 (60s)
# VOTE_DURATION_MS        - default 30000 (30s)
# MAX_MESSAGES_PER_SECOND - default 20
